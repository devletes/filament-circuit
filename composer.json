{
    "name": "devletes/filament-circuit",
    "description": "A node-based canvas for Filament — drag, connect, and configure nodes natively in Livewire and Alpine. What React Flow is for React, without the React.",
    "keywords": [
        "filament",
        "laravel",
        "livewire",
        "alpine",
        "flow",
        "node-editor",
        "workflow-builder",
        "canvas",
        "diagram",
        "graph",
        "react-flow-alternative"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "filament/filament": "^4.0|^5.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Devletes\\Circuit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Devletes\\Circuit\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "filament-assets": "@php vendor/orchestra/testbench-core/laravel/artisan filament:assets --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@filament-assets",
            "@php vendor/bin/testbench serve --port=8765 --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Devletes\\Circuit\\CircuitServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
